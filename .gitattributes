# 统一换行符，避免 Windows 下 autocrlf 造成全仓误报修改
* text=auto eol=lf

# 二进制文件不要做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.apk binary

# 第三方固化的脚本，保持原样不做 diff 折叠
scripts/vendor/*.js linguist-vendored
public/vndb-translator.js linguist-generated
